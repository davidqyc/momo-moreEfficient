# Copy this file to `.env` for local development.
# Never commit `.env` or a real token.

MAIMEMO_API_BASE_URL=https://open.maimemo.com/open/api/v1
MAIMEMO_ACCESS_TOKEN=replace-with-a-local-token

# All write-capable commands must default to true unless explicitly overridden.
MAIMEMO_DRY_RUN=true

# Optional: directory for local sanitized operation reports.
MOMO_AUDIT_DIR=artifacts/private
